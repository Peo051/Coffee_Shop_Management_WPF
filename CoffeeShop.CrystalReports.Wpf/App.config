<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
  <connectionStrings>
    <!--
      Dùng chung database CoffeeShopDB với project chính (CoffeeShop.Wpf).
      Khi muốn đổi server, thay duy nhất ở đây.
      Ưu tiên Trusted_Connection (Windows Authentication) để không lưu mật khẩu.
    -->
    <add name="CoffeeShopDb"
         connectionString="Server=LAPTOP-VHGPK0SP;Database=CoffeeShopDB;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=true"
         providerName="System.Data.SqlClient" />
  </connectionStrings>
</configuration>
