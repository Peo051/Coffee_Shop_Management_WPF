<UserControl x:Class="CoffeeShop.Wpf.Views.TrangThaiSanPhamView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="720"
             d:DesignWidth="980">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid>
            <Grid.RowDefinitions>
                <!-- Header + Filter -->
                <RowDefinition Height="Auto" />
                <RowDefinition Height="12" />
                <!-- Main content: DataGrid + Panel thao tác -->
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- ========================================== -->
            <!-- HEADER + BỘ LỌC -->
            <!-- ========================================== -->
            <Border Grid.Row="0" Style="{StaticResource CardPanel}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionHeader}" Text="Trạng thái sản phẩm" />
                    <TextBlock Margin="0,6,0,0"
                               FontSize="12"
                               Foreground="{DynamicResource MutedTextBrush}"
                               Text="Quản lý tình trạng kinh doanh và ngưỡng cảnh báo tồn kho của từng món." />

                    <!-- Bộ lọc -->
                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Column="0"
                                 Padding="10,6"
                                 Style="{StaticResource HintTextBoxStyle}"
                                 Tag="Tìm theo tên sản phẩm..."
                                 Text="{Binding TuKhoaTimKiem, UpdateSourceTrigger=PropertyChanged}" />

                        <ComboBox Grid.Column="2"
                                  ItemsSource="{Binding DanhMucs}"
                                  SelectedItem="{Binding SelectedDanhMucTimKiem, Mode=TwoWay}"
                                  DisplayMemberPath="TenDanhMuc"
                                  Padding="8,4">
                            <ComboBox.ToolTip>
                                <TextBlock Text="Lọc theo danh mục" />
                            </ComboBox.ToolTip>
                        </ComboBox>

                        <ComboBox Grid.Column="4"
                                  ItemsSource="{Binding TrangThaiFilters}"
                                  SelectedItem="{Binding SelectedTrangThaiTimKiem, Mode=TwoWay}"
                                  DisplayMemberPath="DisplayName"
                                  Padding="8,4">
                            <ComboBox.ToolTip>
                                <TextBlock Text="Lọc theo trạng thái kinh doanh" />
                            </ComboBox.ToolTip>
                        </ComboBox>

                        <Button Grid.Column="6"
                                Width="110"
                                Content="Tìm kiếm"
                                Style="{StaticResource ButtonPrimary}"
                                Command="{Binding TimKiemCommand}" />

                        <Button Grid.Column="8"
                                Width="95"
                                Content="Làm mới"
                                Style="{StaticResource ButtonSecondary}"
                                Command="{Binding LamMoiCommand}" />
                    </Grid>

                    <TextBlock Margin="0,10,0,0"
                               Foreground="{DynamicResource DangerBrush}"
                               TextWrapping="Wrap"
                               Text="{Binding ErrorMessage}" />
                    <TextBlock Margin="0,6,0,0"
                               Foreground="{DynamicResource SuccessBrush}"
                               TextWrapping="Wrap"
                               Text="{Binding SuccessMessage}" />
                </StackPanel>
            </Border>

            <!-- ========================================== -->
            <!-- MAIN CONTENT: DATAGRID + PANEL THAO TÁC -->
            <!-- ========================================== -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="1.1*" />
                </Grid.ColumnDefinitions>

                <!-- DataGrid danh sách sản phẩm -->
                <Border Grid.Column="0" Style="{StaticResource CardPanel}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="8" />
                            <RowDefinition Height="450" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Text="Danh sách sản phẩm" />

                        <DataGrid Grid.Row="2"
                                  ItemsSource="{Binding DanhSachSanPham}"
                                  SelectedItem="{Binding SelectedSanPham, Mode=TwoWay}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  CanUserReorderColumns="False"
                                  CanUserResizeRows="False"
                                  SelectionMode="Single"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  RowHeight="40"
                                  EnableRowVirtualization="True"
                                  EnableColumnVirtualization="True"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto">
                            <DataGrid.Columns>
                                <!-- Mã: 70 -->
                                <DataGridTextColumn Header="Mã" Binding="{Binding MonId}" Width="70" IsReadOnly="True">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="VerticalAlignment" Value="Center" />
                                            <Setter Property="Padding" Value="8,0" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!-- Tên sản phẩm: * -->
                                <DataGridTextColumn Header="Tên sản phẩm" Binding="{Binding TenMon}" Width="*" IsReadOnly="True">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="VerticalAlignment" Value="Center" />
                                            <Setter Property="Padding" Value="8,0" />
                                            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!-- Danh mục: 150 -->
                                <DataGridTextColumn Header="Danh mục" Binding="{Binding TenDanhMuc}" Width="150" IsReadOnly="True">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="VerticalAlignment" Value="Center" />
                                            <Setter Property="Padding" Value="8,0" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!-- Tồn kho: 90 -->
                                <DataGridTextColumn Header="Tồn kho" Binding="{Binding TonKho}" Width="90" IsReadOnly="True">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="VerticalAlignment" Value="Center" />
                                            <Setter Property="Padding" Value="8,0" />
                                            <Setter Property="TextAlignment" Value="Right" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!-- Ngưỡng: 110 -->
                                <DataGridTextColumn Header="Ngưỡng" Binding="{Binding MucCanhBaoTonKho}" Width="110" IsReadOnly="True">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="VerticalAlignment" Value="Center" />
                                            <Setter Property="Padding" Value="8,0" />
                                            <Setter Property="TextAlignment" Value="Right" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!-- Kinh doanh: 120 (thay CheckBox bằng Text thân thiện) -->
                                <DataGridTemplateColumn Header="Kinh doanh" Width="120">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock VerticalAlignment="Center"
                                                       Padding="8,0"
                                                       FontWeight="SemiBold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="Đang bán" />
                                                        <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                                <Setter Property="Text" Value="Ngừng bán" />
                                                                <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <!-- Panel thao tác nhanh -->
                <Border Grid.Column="2" Style="{StaticResource CardPanel}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <TextBlock FontSize="16"
                                       FontWeight="SemiBold"
                                       Text="Thao tác nhanh" />

                            <!-- Empty state khi chưa chọn sản phẩm -->
                            <StackPanel Margin="0,12,0,0">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedSanPham}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <Border Padding="12"
                                        Background="{DynamicResource InfoBackgroundBrush}"
                                        BorderBrush="{DynamicResource InfoBrush}"
                                        BorderThickness="1"
                                        CornerRadius="4">
                                    <TextBlock FontStyle="Italic"
                                               Foreground="{DynamicResource MutedTextBrush}"
                                               TextWrapping="Wrap"
                                               Text="Chọn một sản phẩm trong bảng để thao tác." />
                                </Border>
                            </StackPanel>

                            <!-- Thông tin sản phẩm đang chọn -->
                            <StackPanel>
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedSanPham}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Margin="0,12,0,0"
                                           FontWeight="SemiBold"
                                           Text="Sản phẩm đang chọn" />
                                <TextBlock Margin="0,6,0,0"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource PrimaryBrush}"
                                           TextWrapping="Wrap"
                                           Text="{Binding SelectedSanPham.TenMon}" />
                                <TextBlock Margin="0,4,0,0"
                                           FontSize="12"
                                           Foreground="{DynamicResource MutedTextBrush}">
                                    <Run Text="Tồn kho:" />
                                    <Run Text="{Binding SelectedSanPham.TonKho, Mode=OneWay}" FontWeight="SemiBold" />
                                </TextBlock>
                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                    <TextBlock FontSize="12" Text="Trạng thái: " />
                                    <TextBlock FontSize="12" FontWeight="SemiBold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="Đang bán" />
                                                <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedSanPham.IsActive}" Value="False">
                                                        <Setter Property="Text" Value="Ngừng bán" />
                                                        <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>

                                <Separator Margin="0,12,0,12" />

                                <!-- Khóa / mở kinh doanh -->
                                <TextBlock FontWeight="SemiBold" Text="Quản lý kinh doanh" />
                                <Button Margin="0,6,0,0"
                                        Content="Khóa / mở kinh doanh"
                                        Style="{StaticResource ButtonSecondary}"
                                        Command="{Binding KhoaMoSanPhamCommand}" />

                                <Separator Margin="0,12,0,12" />

                                <!-- Cập nhật ngưỡng cảnh báo -->
                                <TextBlock FontWeight="SemiBold" Text="Mức cảnh báo tồn kho" />
                                <TextBlock Margin="0,4,0,0"
                                           FontSize="11"
                                           FontStyle="Italic"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           TextWrapping="Wrap"
                                           Text="Cảnh báo khi tồn kho ≤ giá trị này" />
                                <TextBox Margin="0,6,0,0"
                                         Padding="10,6"
                                         Text="{Binding MucCanhBaoTonKhoInput, UpdateSourceTrigger=PropertyChanged}" />

                                <Button Margin="0,10,0,0"
                                        Content="Cập nhật ngưỡng cảnh báo"
                                        Style="{StaticResource ButtonPrimary}"
                                        Command="{Binding CapNhatNguongCommand}" />

                                <Separator Margin="0,14,0,12" />

                                <TextBlock FontWeight="SemiBold" Text="Điều chỉnh tồn kho thành phẩm" />
                                <TextBlock Margin="0,4,0,0"
                                           FontSize="11"
                                           FontStyle="Italic"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           TextWrapping="Wrap"
                                           Text="Bắt buộc nhập lý do, tồn kho sau điều chỉnh không được âm." />

                                <TextBlock Margin="0,8,0,4" FontWeight="SemiBold" Text="Loại phát sinh" />
                                <ComboBox ItemsSource="{Binding LoaiDieuChinhTonKhoItems}"
                                          SelectedItem="{Binding SelectedLoaiDieuChinhTonKho, Mode=TwoWay}"
                                          DisplayMemberPath="DisplayName"
                                          Padding="8,4" />

                                <TextBlock Margin="0,8,0,4" FontWeight="SemiBold" Text="Tồn kho mới" />
                                <TextBox Padding="10,6"
                                         Text="{Binding TonKhoMoiInput, UpdateSourceTrigger=PropertyChanged}" />

                                <TextBlock Margin="0,8,0,4" FontWeight="SemiBold" Text="Lý do điều chỉnh (bắt buộc)" />
                                <TextBox Padding="10,6"
                                         MinHeight="56"
                                         TextWrapping="Wrap"
                                         AcceptsReturn="True"
                                         MaxLength="500"
                                         Text="{Binding LyDoDieuChinhTonKho, UpdateSourceTrigger=PropertyChanged}" />

                                <Button Margin="0,10,0,0"
                                        Content="Điều chỉnh tồn kho"
                                        Style="{StaticResource ButtonSecondary}"
                                        Command="{Binding DieuChinhTonKhoCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
