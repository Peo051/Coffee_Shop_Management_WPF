<UserControl x:Class="CoffeeShop.Wpf.Views.CanhBaoTonKhoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="720"
             d:DesignWidth="980">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid>
            <Grid.RowDefinitions>
                <!-- Bộ lọc -->
                <RowDefinition Height="Auto" />
                <RowDefinition Height="12" />
                <!-- Cảnh báo sản phẩm -->
                <RowDefinition Height="Auto" />
                <RowDefinition Height="12" />
                <!-- Cảnh báo nguyên liệu -->
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ========================================== -->
            <!-- BỘ LỌC TÌM KIẾM -->
            <!-- ========================================== -->
            <Border Grid.Row="0"
                    Background="{DynamicResource CardBackgroundBrush}"
                    CornerRadius="10"
                    Padding="16">
                <StackPanel>
                    <TextBlock FontSize="18"
                               FontWeight="SemiBold"
                               Text="Bộ lọc tìm kiếm" />
                    <TextBlock Margin="0,4,0,0"
                               FontSize="12"
                               Foreground="{DynamicResource MutedTextBrush}"
                               Text="Tìm kiếm sản phẩm và nguyên liệu cảnh báo tồn kho thấp." />

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Column="0"
                                 Padding="10,6"
                                 Style="{StaticResource HintTextBoxStyle}"
                                 Tag="Nhập từ khóa"
                                 Text="{Binding TuKhoaTimKiem, UpdateSourceTrigger=PropertyChanged}" />

                        <ComboBox Grid.Column="2"
                                  ItemsSource="{Binding DanhMucs}"
                                  SelectedItem="{Binding SelectedDanhMuc, Mode=TwoWay}"
                                  DisplayMemberPath="TenDanhMuc"
                                  Padding="8,4">
                            <ComboBox.ToolTip>
                                <TextBlock Text="Lọc theo danh mục (chỉ áp dụng cho sản phẩm)" />
                            </ComboBox.ToolTip>
                        </ComboBox>

                        <Button Grid.Column="4"
                                Width="120"
                                Content="Tải danh sách"
                                Command="{Binding TaiDanhSachCommand}" />

                        <Button Grid.Column="6"
                                Width="95"
                                Content="Làm mới"
                                Command="{Binding LamMoiCommand}"
                                Background="{DynamicResource SecondaryBrush}"
                                BorderBrush="{DynamicResource SecondaryBrush}"
                                Foreground="{DynamicResource SecondaryTextBrush}" />
                    </Grid>

                    <TextBlock Margin="0,10,0,0"
                               Foreground="{DynamicResource DangerBrush}"
                               TextWrapping="Wrap"
                               Text="{Binding ErrorMessage}" />
                    <TextBlock Margin="0,6,0,0"
                               Foreground="{DynamicResource SuccessBrush}"
                               TextWrapping="Wrap"
                               Text="{Binding SuccessMessage}" />
                </StackPanel>
            </Border>

            <!-- ========================================== -->
            <!-- CẢNH BÁO TỒN KHO SẢN PHẨM -->
            <!-- ========================================== -->
            <Border Grid.Row="2"
                    Background="{DynamicResource CardBackgroundBrush}"
                    CornerRadius="10"
                    Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="8" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock FontSize="18"
                                   FontWeight="SemiBold"
                                   Text="Cảnh báo tồn kho sản phẩm" />
                        <TextBlock Margin="0,4,0,0"
                                   FontSize="12"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   Text="Danh sách sản phẩm/món có tồn kho thấp hơn hoặc bằng ngưỡng cảnh báo." />
                    </StackPanel>

                    <DataGrid Grid.Row="2"
                              Height="260"
                              ItemsSource="{Binding DanhSachCanhBao}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              CanUserReorderColumns="False"
                              CanUserResizeRows="False"
                              SelectionMode="Single"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              RowHeight="40"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <!-- Mã: 70 -->
                            <DataGridTextColumn Header="Mã" Binding="{Binding MonId}" Width="70" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center" />
                                        <Setter Property="Padding" Value="8,0" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Tên sản phẩm: * -->
                            <DataGridTextColumn Header="Tên sản phẩm" Binding="{Binding TenMon}" Width="*" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center" />
                                        <Setter Property="Padding" Value="8,0" />
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Danh mục: 150 -->
                            <DataGridTextColumn Header="Danh mục" Binding="{Binding TenDanhMuc}" Width="150" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center" />
                                        <Setter Property="Padding" Value="8,0" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Tồn kho: 100 -->
                            <DataGridTextColumn Header="Tồn kho" Binding="{Binding TonKho}" Width="100" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center" />
                                        <Setter Property="Padding" Value="8,0" />
                                        <Setter Property="TextAlignment" Value="Right" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Ngưỡng cảnh báo: 140 -->
                            <DataGridTextColumn Header="Ngưỡng cảnh báo" Binding="{Binding MucCanhBaoTonKho}" Width="140" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center" />
                                        <Setter Property="Padding" Value="8,0" />
                                        <Setter Property="TextAlignment" Value="Right" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Cần bổ sung: 120 -->
                            <DataGridTextColumn Header="Cần bổ sung" Binding="{Binding SoLuongCanBoSung}" Width="120" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center" />
                                        <Setter Property="Padding" Value="8,0" />
                                        <Setter Property="TextAlignment" Value="Right" />
                                        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- ========================================== -->
            <!-- CẢNH BÁO TỒN KHO NGUYÊN LIỆU -->
            <!-- ========================================== -->
            <Border Grid.Row="4"
                    Background="{DynamicResource CardBackgroundBrush}"
                    CornerRadius="10"
                    Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="8" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock FontSize="18"
                                   FontWeight="SemiBold"
                                   Text="Cảnh báo tồn kho nguyên liệu" />
                        <TextBlock Margin="0,4,0,0"
                                   FontSize="12"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   Text="Danh sách nguyên liệu có tồn kho thấp hơn hoặc bằng ngưỡng cảnh báo." />
                    </StackPanel>

                    <DataGrid Grid.Row="2"
                              Height="260"
                              ItemsSource="{Binding DanhSachCanhBaoNguyenLieu}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              CanUserReorderColumns="False"
                              CanUserResizeRows="False"
                              SelectionMode="Single"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              RowHeight="40"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <!-- Mã: 90 -->
                            <DataGridTextColumn Header="Mã" Binding="{Binding NguyenLieuId}" Width="90" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center" />
                                        <Setter Property="Padding" Value="8,0" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Tên nguyên liệu: * -->
                            <DataGridTextColumn Header="Tên nguyên liệu" Binding="{Binding TenNguyenLieu}" Width="*" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center" />
                                        <Setter Property="Padding" Value="8,0" />
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Tồn kho: 100 -->
                            <DataGridTextColumn Header="Tồn kho" Binding="{Binding TonKho, StringFormat=N2}" Width="100" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center" />
                                        <Setter Property="Padding" Value="8,0" />
                                        <Setter Property="TextAlignment" Value="Right" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Đơn vị tính: 80 -->
                            <DataGridTextColumn Header="ĐVT" Binding="{Binding DonViTinh}" Width="80" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center" />
                                        <Setter Property="Padding" Value="8,0" />
                                        <Setter Property="TextAlignment" Value="Center" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Ngưỡng cảnh báo: 140 -->
                            <DataGridTextColumn Header="Ngưỡng cảnh báo" Binding="{Binding TonKhoToiThieu, StringFormat=N2}" Width="140" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center" />
                                        <Setter Property="Padding" Value="8,0" />
                                        <Setter Property="TextAlignment" Value="Right" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Cần bổ sung: 120 -->
                            <DataGridTextColumn Header="Cần bổ sung" Binding="{Binding SoLuongCanBoSung, StringFormat=N2}" Width="120" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center" />
                                        <Setter Property="Padding" Value="8,0" />
                                        <Setter Property="TextAlignment" Value="Right" />
                                        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Trạng thái: 120 -->
                            <DataGridTemplateColumn Header="Trạng thái" Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding TrangThaiTonKhoHienThi}"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center"
                                                   Padding="8,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding TrangThaiTonKhoHienThi}" Value="Hết hàng">
                                                            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding TrangThaiTonKhoHienThi}" Value="Sắp hết">
                                                            <Setter Property="Foreground" Value="#FF9800" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
