<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <appSettings>
        <!-- Payment API Base URL - Thay đổi URL này khi deploy hoặc dùng ngrok mới -->
        <!-- Dùng localhost khi chạy API local -->
        <add key="PaymentApiBaseUrl" value="https://localhost:5002" />
        
        <!-- PayOS API Credentials (dùng chạy trực tiếp offline không cần API backend) -->
        <add key="PayOsClientId" value="c60d8359-370b-45a4-94c9-830d2e0cd9dd" />
        <add key="PayOsApiKey" value="adfad0a3-9dae-4a91-ad41-c9c263da3ade" />
        <add key="PayOsChecksumKey" value="b81d6480b490e3b7a8ce1aebbf135467df93c7b9083239357bab17092a926414" />
        <add key="PayOsBaseUrl" value="https://api-merchant.payos.vn" />
    </appSettings>
    
    <connectionStrings>
        <!-- Local SQL Server với Windows Authentication -->
        <add name="CoffeeShopDb"
            connectionString="Server=.;Database=CoffeeShopDB;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=true" 
            providerName="System.Data.SqlClient" />
    </connectionStrings>
</configuration>
