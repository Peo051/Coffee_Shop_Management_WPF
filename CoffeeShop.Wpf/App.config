<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <connectionStrings>
        <!-- Khai báo connection string ở đây thay vì hard-code -->
        <add name="CoffeeShopDb" 
             connectionString="Server=localhost;Database=CoffeeShopDb;Trusted_Connection=True;TrustServerCertificate=True;" 
             providerName="System.Data.SqlClient" />
    </connectionStrings>
</configuration>